{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loretto-admissions",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "loretto-admissions", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": { "CLERK_ISSUER": "https://replace-with-your-clerk-domain", "ADMIN_EMAILS": "admissions@lorettocentralschool.edu.in" }
}
