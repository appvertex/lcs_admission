{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loretto-admissions",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "routes": [
    { "pattern": "admission.lorettocentralschool.edu.in", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "loretto-admissions", "database_id": "0d42c466-3fab-4b19-a0f3-cbcd519bd32f", "migrations_dir": "migrations" }
  ],
  "vars": {
    "CLERK_ISSUER": "https://clerk.lorettocentralschool.edu.in",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:5173,https://admission.lorettocentralschool.edu.in",
    "ADMIN_EMAILS": "admissions@lorettocentralschool.edu.in"
  }
}
